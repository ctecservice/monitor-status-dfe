# ============================================================
# DadosJah StatusDFe - Configuracoes do projeto
#
# 1. Copie este arquivo para .env na raiz do projeto
#    (comando: copy .env.example .env)
# 2. Ajuste os valores conforme a necessidade
# 3. O arquivo .env NAO deve ser versionado
# ============================================================

# --- API DadosJah ---
# URL base da API que consulta o status dos servicos SEFAZ (DF-e)
API_BASE_URL=https://api-dfe.dadosjah.com.br
# Timeout (em segundos) por requisicao a API
API_TIMEOUT_S=20

# --- Autenticacao na API DadosJah (login de usuario) ---
# Credenciais usadas pelo coletor para obter o token de acesso.
# O token e obtido em POST /v1/auth/user/login e enviado no header
# Authorization das consultas de status. Valores reais ficam somente
# no .env local (nunca versionado).
API_LOGIN_USUARIO=
API_LOGIN_SENHA=

# --- Seguranca ---
# Master key do monitor: protege os segredos criptografados (tabela segredos)
# e deriva a chave de sessao do Flask. NAO defina manualmente: o script de
# primeiro boot (src/scripts/configurar.py) gera e grava este valor no .env.
MONITOR_MASTER_KEY=

# Cookies de sessao do Flask: defina "true" somente em producao (com HTTPS).
# No desenvolvimento local, deixe vazio (False).
SESSION_COOKIE_SECURE=

# --- Turnstile (anti-bot das APIs publicas) ---
# Protecao das APIs publicas JSON com Cloudflare Turnstile.
# Onde obter: painel da Cloudflare -> Turnstile -> criar um site (widget).
# - TURNSTILE_SITE_KEY: chave publica do widget; vai para o HTML das paginas.
# - TURNSTILE_SECRET_KEY: chave secreta; fica SOMENTE no backend (.env).
# Sem as duas chaves preenchidas a protecao fica DESLIGADA (util no dev).
# Chaves dummy para testes (funcionam em qualquer dominio/localhost):
#   site sempre-passa: 1x00000000000000000000AA
#   secret sempre-sucesso: 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Coleta ---
# UFs monitoradas (siglas separadas por virgula). Usadas apenas como fallback
# quando "ufs_monitoradas" estiver vazia em config.json.
UFS=AC,AL,AP,AM,BA,CE,DF,ES,GO,MA,MT,MS,MG,PA,PB,PR,PE,PI,RJ,RN,RS,RO,RR,SC,SP,SE,TO
# Ambientes: 1=producao, 2=homologacao (separados por virgula)
TP_AMBS=1,2
# Intervalo entre coletas, timeout, retencoes e demais ajustes operacionais
# ficam em config.json, na raiz do projeto (nao neste arquivo).

# --- Banco de dados ---
# Caminho do arquivo SQLite (relativo a raiz do projeto)
BANCO_CAMINHO=data/statusdfe.db

# --- Logs ---
# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_NIVEL=INFO
